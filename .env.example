# Canvas LMS access
# Required by Canvas-backed Guardian services and the Academic Data Pipeline.
# Base URL should not include a trailing slash.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_ACCESS_TOKEN=

# Telegram runtime
# Required by Guardian notification monitors and the Telegram command bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Google Calendar synchronization
# Required only by the Calendar sync service.
GOOGLE_CALENDAR_ID=
