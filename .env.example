# Canvas LMS access
# Required by Canvas-backed Guardian services and the Academic Data Pipeline.
# Base URL should not include a trailing slash.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_ACCESS_TOKEN=

# Optional AI drafting, used only after an explicit draft/revision request.
# Key must be enabled for the Gemini API in Google AI Studio.
GEMINI_API_KEY=
# Stable default: gemini-3.8-flash. Set this only to a model available to your key.
GEMINI_MODEL=gemini-3.8-flash

# Telegram runtime
# Required by Guardian notification monitors and the Telegram command bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Optional: maximum uploaded Roll Call CSV size in MiB (1–20; default 5).
TELEGRAM_REPORT_MAX_CSV_MIB=5

# Google Calendar synchronization
# Required only by the Calendar sync service.
GOOGLE_CALENDAR_ID=
