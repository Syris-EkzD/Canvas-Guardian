[Unit]
Description=Canvas Guardian Telegram command bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=canvasguardian
Group=canvasguardian
WorkingDirectory=/opt/canvas-guardian
EnvironmentFile=/etc/canvas-guardian/guardian.env
ExecStart=/usr/bin/npm run guardian:telegram
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=multi-user.target
